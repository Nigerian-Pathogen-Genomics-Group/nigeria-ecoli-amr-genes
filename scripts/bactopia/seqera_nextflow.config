// Extra Nextflow config used on Seqera Cloud (added to the settings Seqera generates for the compute environment).
plugins {
    id 'nf-amazon'
    id 'nf-bactopia@2.1.7'
}

docker {
    enabled = true
    registry = 'quay.io'
}

params {
    queue = 'general'
    disable_scratch = false
    max_memory = '128.GB'
    max_time = '240.h'
}
